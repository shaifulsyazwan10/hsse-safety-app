rules_version = '2';
// HSSE Safety app – only these sign-in emails can see or change records.
// To add a person: add their email to the list below, then click Publish in Firebase console > Firestore > Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeam() {
      return request.auth != null && request.auth.token.email in [
        'shaifulsyazwan@octagonmaju.com.my',
        'hsse7@octagonmaju.com.my',
        'hsse10@octagonmaju.com.my'
      ];
    }
    match /{collection}/{id} {
      allow read, write: if isTeam() && collection in ['audits', 'tasks', 'toolbox', 'photos', 'settings', 'drivelog'];
    }
  }
}
